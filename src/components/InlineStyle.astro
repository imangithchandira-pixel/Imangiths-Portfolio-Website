---
/* A page's own generated CSS, inlined. The Content Security Policy only allows
   styles it knows the hash of, so the hash goes into this page's policy. */
import { createHash } from 'node:crypto';

interface Props {
  css: string;
}
const { css } = Astro.props;
Astro.csp?.insertStyleHash(`sha256-${createHash('sha256').update(css).digest('base64')}`);
---

<style is:inline set:html={css} />
