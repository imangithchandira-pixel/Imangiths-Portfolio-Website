---
import '../styles/global.css';
import fontUrl from '../assets/fonts/newsreader-350.woff2?url';
import { SITE } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SpeculationRules from '../components/SpeculationRules.astro';

interface Props {
  description: string;
  /** Which header link is the current page. */
  current?: 'projects' | 'about';
  /** Pages that scroll get a white wash behind the header once scrolled. */
  wash?: boolean;
  footer?: boolean;
  htmlClass?: string;
  ogImage?: string;
}

const { description, current, wash = true, footer = true, htmlClass, ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), SITE.url);
---

<!doctype html>
<html lang="en" class={htmlClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{SITE.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, SITE.url)} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
    <SpeculationRules />
  </head>
  <body>
    <div class="topfade" aria-hidden="true">
      <div class="topfade__blur"></div><div class="topfade__blur"></div><div class="topfade__blur"></div>
      {wash && <div class="topfade__wash"></div>}
    </div>

    <Header current={current} />

    <slot />

    {footer && <Footer />}
  </body>
</html>

<script>
  import '../scripts/site';
</script>
